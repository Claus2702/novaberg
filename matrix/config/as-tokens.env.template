# Die beiden Tokens des Application Service  (MUSTER)
#
# Kopieren nach  matrix/config/as-tokens.env  und ausfuellen. Es sind
# DIESELBEN zwei Werte, die in novaberg-as.yaml stehen — der Homeserver liest
# sie dort, der Connector hier, und weichen sie voneinander ab, weist jede
# Seite die andere ab.
#
# Erzeugen z. B. mit:  openssl rand -hex 32
MATRIX_AS_TOKEN=
MATRIX_HS_TOKEN=
