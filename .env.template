# Novaberg — Vorlage fuer die .env
#
# Kopieren nach ../.env (also NEBEN das Repositorium, nicht hinein) und die
# Platzhalter ersetzen. Die ausgefuellte Datei gehoert nicht ins
# Repositorium; die .gitignore haelt sie draussen.
#
# Alle uebrigen Parameter haben in server/config.py brauchbare Vorgabewerte
# und lassen sich bei Bedarf hier ueberschreiben.

# ─────────────────────────────────────────────
# Telegram — ABGESCHALTET am 24.08.2026
# ─────────────────────────────────────────────
# Der Kanal ist aus, der Dienst steht nicht mehr in der Compose-Datei;
# `telegram_bot/` liegt weiter im Repositorium. Diese beiden Werte werden
# nur gebraucht, wenn der Kanal zurueckgeholt wird — sonst leer lassen.
# Vom BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# Eigene Telegram-User-ID, ermittelbar ueber @userinfobot.
# Format: telegram_user_id:novaberg_user_id, mehrere durch Komma getrennt.
TELEGRAM_USER_MAP=

# ─────────────────────────────────────────────
# Anthropic — nur noetig bei LLM_PROFILE=claude
# ─────────────────────────────────────────────
# Leer lassen, wenn ausschliesslich lokal ueber Ollama gefahren wird.
ANTHROPIC_API_KEY=
