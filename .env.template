# Novaberg — Vorlage fuer die .env
#
# Kopieren nach ../.env (also NEBEN das Repositorium, nicht hinein) und die
# Platzhalter ersetzen. Die ausgefuellte Datei gehoert nicht ins
# Repositorium; die .gitignore haelt sie draussen.
#
# Alle uebrigen Parameter haben in server/config.py brauchbare Vorgabewerte
# und lassen sich bei Bedarf hier ueberschreiben.

# ─────────────────────────────────────────────
# Telegram — ABGESCHALTET am 24.08.2026
# ─────────────────────────────────────────────
# Der Kanal ist aus, der Dienst steht nicht mehr in der Compose-Datei;
# `telegram_bot/` liegt weiter im Repositorium. Diese beiden Werte werden
# nur gebraucht, wenn der Kanal zurueckgeholt wird — sonst leer lassen.
# Vom BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# Eigene Telegram-User-ID, ermittelbar ueber @userinfobot.
# Format: telegram_user_id:novaberg_user_id, mehrere durch Komma getrennt.
TELEGRAM_USER_MAP=

# ─────────────────────────────────────────────
# Anthropic — nur noetig bei LLM_PROFILE=claude
# ─────────────────────────────────────────────
# Leer lassen, wenn ausschliesslich lokal ueber Ollama gefahren wird.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# OpenRouter — nur noetig, wenn ein Worker auf "openrouter" steht
# ─────────────────────────────────────────────
# Ein Zugang, viele Modelle: Die Modell-ID entscheidet, welcher Anbieter
# antwortet. Leer lassen, wenn ausschliesslich lokal gefahren wird — ein
# Worker mit Backend "openrouter" und ohne Schluessel bricht beim Start ab,
# und das ist Absicht.
OPENROUTER_API_KEY=

# Ueberschreibt den Vorgabewert aus server/config.py. Die ID muss in der
# Modellliste des Anbieters stehen (`GET /api/v1/models`); eine erfundene
# wird mit HTTP 400 beantwortet.
#
# **Die ID allein legt das Modell nicht fest** — hinter ihr stehen mehrere
# Anbieter mit verschiedenen Preisen, Quantisierungen und Kontextfenstern.
# Wer sie festnageln will, setzt OPENROUTER_PROVIDER und
# OPENROUTER_QUANTISIERUNG (Vorgaben in server/config.py).
# `python -m tools.openrouter_price_watch` haelt die Konfiguration gegen den
# lebenden Endpunkt und braucht dafuer keinen Schluessel.
OPENROUTER_MODEL=
